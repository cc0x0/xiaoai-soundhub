# ==========================================
# XiaoAi SoundHub 环境变量配置文件 (.env)
# 复制为 .env 即可持久保存配置，后续升级代码无需重复修改！
# ==========================================

# 外部访问端口 (对应服务器开放的端口，如 8989)
SERVER_PORT=8989

# SaaS 超级管理员初始登录密码 (用户名默认为: admin)
ADMIN_PASSWORD=admin123456

# 数据加解密盐值 (留空则自动生成安全密钥)
SECURITY_SALT=SoundHub_Master_Secret_Key_2026

# 必填：外网访问地址与端口（端口需与上方 SERVER_PORT 保持一致）
PUBLIC_BASE_URL=http://你的云服务器IP:8989

# 提示：小米账号绑定、音箱管理、音源热切换、语音监听开关、魔数延时等
# 全部已支持在 Web 网页前端与 /admin 管理后台进行可视化热配置，无需在此硬编码！


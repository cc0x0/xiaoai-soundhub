# ==========================================
# XiaoAi SoundHub 环境变量配置文件 (.env)
# 复制为 .env 即可持久保存配置，后续升级代码无需重复修改！
# ==========================================

# 外部访问端口 (对应服务器开放的端口，如 8989)
SERVER_PORT=8989

# 必填：你的小米账号数字ID与 passToken
XIAOI_USER_ID=你的小米ID
XIAOI_PASS_TOKEN=你的passToken

# 必填：外网访问地址与端口（端口需与上方 SERVER_PORT 保持一致）
PUBLIC_BASE_URL=http://你的云服务器IP:8989

# 安全防护：公网访问口令/密码 (设置后访问网页和API必须验证密码)
ACCESS_PASSWORD=

# 可选：默认设备DID (留空则自动识别主音箱)
XIAOI_DEFAULT_DID=

# 当前生效音源 (可选: my-custom-source.js / xh.js / lx-v5.js)
ACTIVE_SOURCE=my-custom-source.js

# 是否开启语音指令监听
ENABLE_LISTENER=true
